{
  "singleQuote": true,
  "tabWidth": 2,
  "printWidth": 120,
  "semi": true,
  "trailingComma": "es5",
  "bracketSpacing": true,
  "jsxBracketSameLine": false,
  "arrowParens": "always",
  "endOfLine": "lf",
  "overrides": [
    {
      "files": "**/*.js, **/*.jsx",
      "options": {
        "parser": "babel"
      }
    },
    {
      "files": "**/*.ts, **/*.tsx",
      "options": {
        "parser": "typescript"
      }
    }
  ]
}
